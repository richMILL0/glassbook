{
 "uid": "glassbook",
 "title": "Glassbook",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Commands per second",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(glassbook_engine_commands_total[30s])",
     "legendFormat": "commands/s"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Orders by outcome (per second)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(glassbook_orders_total[30s]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Trades per second",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (symbol) (rate(glassbook_trades_total[30s]))",
     "legendFormat": "{{symbol}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Order latency (HTTP handler to durable result)",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(glassbook_order_latency_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(glassbook_order_latency_seconds_bucket[1m])))",
     "legendFormat": "p99"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.999, sum by (le) (rate(glassbook_order_latency_seconds_bucket[1m])))",
     "legendFormat": "p99.9"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Engine queue depth",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "glassbook_engine_queue_depth",
     "legendFormat": "queued commands"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Projection lag (commands applied but not yet in the database)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "glassbook_projection_lag",
     "legendFormat": "lag"
    },
    {
     "refId": "B",
     "expr": "glassbook_pipeline_backlog",
     "legendFormat": "event groups waiting"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Engine thread cost per command",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(glassbook_engine_apply_seconds_total[30s]) / rate(glassbook_engine_commands_total[30s])",
     "legendFormat": "state machine"
    },
    {
     "refId": "B",
     "expr": "rate(glassbook_engine_journal_seconds_total[30s]) / rate(glassbook_engine_commands_total[30s])",
     "legendFormat": "journal + fsync (amortized)"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Group commit batch size",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(glassbook_engine_commands_total[30s]) / rate(glassbook_engine_batches_total[30s])",
     "legendFormat": "commands per fsync"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Outbox -> Kafka (events per second) and WebSocket sessions",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(glassbook_outbox_published_total[30s])",
     "legendFormat": "published/s"
    },
    {
     "refId": "B",
     "expr": "glassbook_websocket_sessions",
     "legendFormat": "ws sessions"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "JVM heap and GC pause",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "heap used"
    },
    {
     "refId": "B",
     "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
     "legendFormat": "gc pause s/s"
    }
   ]
  }
 ],
 "tags": [
  "glassbook"
 ]
}